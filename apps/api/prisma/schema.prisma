// This is your Prisma schema file
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public"), pg_trgm]
}

model User {
  id              String    @id @default(cuid())
  clerkId         String?   @unique
  email           String    @unique
  passwordHash    String?
  name            String
  avatarUrl       String?
  cpf             String?   @unique
  phone           String?
  role            Role      @default(USER)
  isEmailVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  companies       Company[]
  reviews         Review[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([clerkId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  companies   CompanyCategory[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
}

model Company {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  cnpj                  String?   @unique
  description           String
  shortDescription      String?
  logoUrl               String?
  coverImageUrl         String?
  images                String[]
  website               String?
  email                 String?
  phone                 String?
  whatsapp              String?
  street                String?
  number                String?
  complement            String?
  neighborhood          String?
  city                  String?
  state                 String?
  zipCode               String?
  latitude              Float?
  longitude             Float?
  tags                  String[]
  status                CompanyStatus @default(PENDING)
  plan                  ListingPlan   @default(FREE)
  isFeatured            Boolean   @default(false)
  featuredUntil         DateTime?
  viewCount             Int       @default(0)
  clickCount            Int       @default(0)
  rating                Float?
  reviewCount           Int       @default(0)
  aiGeneratedDescription Boolean  @default(false)
  embedding             Unsupported("vector(1536)")?
  embeddingUpdatedAt    DateTime?
  ownerId               String
  owner                 User      @relation(fields: [ownerId], references: [id])
  categories            CompanyCategory[]
  reviews               Review[]
  businessHours         BusinessHours[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([slug])
  @@index([city, state])
  @@index([status])
  @@index([ownerId])
}

model CompanyCategory {
  companyId  String
  categoryId String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([companyId, categoryId])
}

model BusinessHours {
  id         String  @id @default(cuid())
  companyId  String
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean @default(false)
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  title     String?
  content   String
  companyId String
  userId    String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

enum Role {
  ADMIN
  BUSINESS_OWNER
  USER
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum ListingPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}
